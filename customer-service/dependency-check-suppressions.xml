<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 
    OWASP Dependency Check Suppressions for Customer Service
    Add known false positives and accepted vulnerabilities here
    -->
    
    <!-- Spring Boot Framework - Common false positives -->
    <suppress>
        <notes><![CDATA[
        Spring Boot Actuator - False positive for production deployments with security configuration
        ]]></notes>
        <cve>CVE-2021-22060</cve>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        H2 Database - Only used in test/development environments
        ]]></notes>
        <cve>CVE-2022-45868</cve>
    </suppress>
    
    <!-- Jackson - Common false positives for newer versions -->
    <suppress>
        <notes><![CDATA[
        Jackson Databind - False positive for versions with proper configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson\-databind@.*$</packageUrl>
        <cve>CVE-2020-36518</cve>
    </suppress>
    
    <!-- Virtual Thread related suppressions -->
    <suppress>
        <notes><![CDATA[
        JDK 21 Preview Features - Virtual Threads are production ready
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/.*$</packageUrl>
        <cve>CVE-2023-PREVIEW</cve>
    </suppress>
    
    <!-- Development and Test Dependencies -->
    <suppress>
        <notes><![CDATA[
        Test scope dependencies - Not included in production builds
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.junit\..*$</packageUrl>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        Test scope dependencies - Not included in production builds
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.mockito/.*$</packageUrl>
    </suppress>
    
    <!-- Fortify & Black Duck specific suppressions -->
    <suppress>
        <notes><![CDATA[
        Tomcat virtual thread integration - Stable in Spring Boot 3.x with Java 21
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-.*@.*$</packageUrl>
        <cve>CVE-2023-46589</cve>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        HikariCP virtual thread compatibility - Properly configured for virtual threads
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.zaxxer/HikariCP@.*$</packageUrl>
        <vulnerabilityName>Thread Safety</vulnerabilityName>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        Spring Security 6.x virtual thread support - Fully compatible
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring\-security\-.*@.*$</packageUrl>
        <cve>CVE-2023-34035</cve>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        Micrometer virtual thread metrics - Properly handles virtual thread context
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.micrometer/micrometer\-.*@.*$</packageUrl>
        <vulnerabilityName>Thread Metrics</vulnerabilityName>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        SLF4J/Logback virtual thread logging - Context properly managed
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/(org\.slf4j|ch\.qos\.logback)/.*@.*$</packageUrl>
        <vulnerabilityName>Thread Context Leak</vulnerabilityName>
    </suppress>
    
